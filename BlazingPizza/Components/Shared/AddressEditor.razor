@namespace BlazingPizza.Components.Shared
@using BlazingPizza.Data

        <!-- Name -->
        <div class="col-12">
            <label class="form-label fw-semibold">
                Name
            </label>

            <InputText
                class="form-control"
                @bind-Value="Address.Name"
                placeholder="Enter your full name" />
                <ValidationMessage For="@(() => Address.Name)" />
        </div>

        <!-- Address Line 1 -->
        <div class="col-12">
            <label class="form-label fw-semibold">
                Address Line 1
            </label>

            <InputText
                class="form-control"
                @bind-Value="Address.Line1"
                placeholder="Street address" />
                <ValidationMessage For="@(() => Address.Line1)" />
        </div>

        <!-- Address Line 2 -->
        <div class="col-12">
            <label class="form-label fw-semibold">
                Address Line 2
            </label>

            <InputText
                class="form-control"
                @bind-Value="Address.Line2"
                placeholder="Apartment, suite, etc. (optional)" />
                <ValidationMessage For="@(() => Address.Line2)" />
        </div>

        <!-- City -->
        <div class="col-12">
            <label class="form-label fw-semibold">
                City
            </label>

            <InputText
                class="form-control"
                @bind-Value="Address.City"
                placeholder="City" />
                <ValidationMessage For="@(() => Address.City)" />
        </div>

        <!-- Region -->
        <div class="col-12">
            <label class="form-label fw-semibold">
                Region
            </label>

            <InputText
                class="form-control"
                @bind-Value="Address.Region"
                placeholder="Region / State" />
                <ValidationMessage For="@(() => Address.Region)" />
        </div>

        <!-- Postal Code -->
        <div class="col-12">
            <label class="form-label fw-semibold">
                Postal Code
            </label>

            <InputText
                class="form-control"
                @bind-Value="Address.PostalCode"
                placeholder="Postal code" />
                <ValidationMessage For="@(() => Address.PostalCode)" />
        </div>


@code {
    [Parameter]
    public Address Address { get; set; } = new Address();
}