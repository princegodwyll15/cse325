@using BlazingPizza.Services
@using BlazingPizza.Data
@inject PizzaService pizzaService
@page "/pizzas"

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-warning mb-1">
                🍕 Pizzas
            </h1>

            <p class="text-muted mb-0">
                Freshly prepared pizzas available today
            </p>
        </div>
    </div>

    @if (todaysPizzas != null && todaysPizzas.Any())
    {
        <div class="row g-4">

            @foreach (var pizza in todaysPizzas)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body d-flex flex-column">

                            <!-- Pizza Name -->
                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <h5 class="card-title fw-bold mb-0">
                                    @pizza.Name
                                </h5>

                                <span class="badge bg-warning text-dark fs-6">
                                    $@pizza.Price
                                </span>

                            </div>

                            <!-- Description -->
                            <p class="card-text text-muted flex-grow-1">
                                @pizza.Description
                            </p>

                            <!-- Tags -->
                            <div class="d-flex flex-wrap gap-2 mt-3">

                                @if (pizza.Vegetarian)
                                {
                                    <span class="badge bg-success">
                                        Vegetarian
                                    </span>
                                }

                                @if (pizza.Vegan)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">
                                        Vegan
                                    </span>
                                }

                                @if (!pizza.Vegetarian && !pizza.Vegan)
                                {
                                    <span class="badge bg-secondary">
                                        Classic
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Loading -->
        <div class="d-flex flex-column justify-content-center align-items-center py-5">

            <div class="spinner-border text-warning mb-3"
                 style="width: 3rem; height: 3rem;"
                 role="status">

                <span class="visually-hidden">
                    Loading...
                </span>
            </div>

            <span class="fs-5 text-muted">
                Loading pizzas...
            </span>

        </div>
    }
</div>

@code {
    private List<Pizza> todaysPizzas = new();

    protected override async Task OnInitializedAsync()
    {
        todaysPizzas = await pizzaService.GetPizzaAsync();
    }
}