@using BlazingPizza.Data
@using BlazingPizza.Services


@page "/checkout"

@inject OrderState OrderState
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<PageTitle>Checkout</PageTitle>

<div class="main">

    @if (OrderState.Order == null || !OrderState.Order.Pizzas.Any())
    {
        <h3>Your order is empty.</h3>

        <a class="btn btn-success" href="/">
            Order some pizza
        </a>
    }
    else
    {
<div class="container py-4">
    <div class="row g-4">

        <!-- Order Review -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-4">Review Order</h4>

                    <BlazingPizza.Components.Shared.OrderReview
                        Order="OrderState.Order" />
                </div>
            </div>
        </div>

        <!-- Delivery Address -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-4">Deliver To...</h4>

                    <BlazingPizza.Components.Shared.AddressEditor
                        Address="OrderState.Order.DeliveryAddress" />
                </div>
            </div>
        </div>

    </div>

    <!-- Button -->
    <div class="d-grid mt-4 w-100">
        <button
            class="btn btn-success btn-sm w-100"
            @onclick="PlaceOrder"
            disabled="@isSubmitting">

            @if (isSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Placing Order...</span>
            }
            else
            {
                <span>Place Order</span>
            }
        </button>
    </div>
</div>}

</div>

@code {
    bool isSubmitting;

async Task PlaceOrder()
{
    isSubmitting = true;

    var response = await HttpClient.PostAsJsonAsync(
        NavigationManager.BaseUri + "orders",
        OrderState.Order);

    if (response.IsSuccessStatusCode)
    {
        OrderState.ResetOrder();

        NavigationManager.NavigateTo("/myorders");
    }
    }
}