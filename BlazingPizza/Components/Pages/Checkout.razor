@using BlazingPizza.Data
@using BlazingPizza.Services


@page "/checkout"

@inject OrderState OrderState
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<PageTitle>Checkout</PageTitle>

<div class="main">

    @if (OrderState.Order == null || !OrderState.Order.Pizzas.Any())
    {
        <h3>Your order is empty.</h3>

        <a class="btn btn-success" href="/">
            Order some pizza
        </a>
    }
    else
    {
        <div class="main">
    <div class="checkout-cols">
        <div class="checkout-order-details">
            <h4>Review order</h4>
            <BlazingPizza.Components.Shared.OrderReview Order="OrderState.Order" />
        </div>

        <div class="checkout-delivery-address">
            <h4>Deliver to...</h4>
            <BlazingPizza.Components.Shared.AddressEditor Address="OrderState.Order.DeliveryAddress" />
        </div>
    </div>

    <button class="checkout-button btn btn-warning" @onclick="PlaceOrder" disabled=@isSubmitting>
        Place order
    </button>
</div>

        <button class="checkout-button btn btn-warning"
                @onclick="PlaceOrder"
                disabled="@isSubmitting">

            Place order
        </button>
    }

</div>

@code {
    bool isSubmitting;

async Task PlaceOrder()
{
    isSubmitting = true;

    var response = await HttpClient.PostAsJsonAsync(
        NavigationManager.BaseUri + "orders",
        OrderState.Order);

    if (response.IsSuccessStatusCode)
    {
        OrderState.ResetOrder();

        NavigationManager.NavigateTo("/myorders");
    }
    }
}