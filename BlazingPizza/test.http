@BlazingPizza_HostAddress = http://localhost:5044

###
GET {{BlazingPizza_HostAddress}}/specials

### Get all orders
GET {{BlazingPizza_HostAddress}}/orders


### Get a specific order
GET {{BlazingPizza_HostAddress}}/orders/1

###
DELETE {{BlazingPizza_HostAddress}}/orders/1

### Create a new order
POST {{BlazingPizza_HostAddress}}/orders
Content-Type: application/json

{
  "pizzas": [
    {
      "specialId": 2,
      "size": 12
    }
  ]
}

###
GET {{BlazingPizza_HostAddress}}/toppings