@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@* <input @onchange="OnInputChange" value="@text" /> *@
@* <input @bind="text" @bind:event="oninput" /> *@
<input type="text" @bind="text" @bind:event="oninput" @bind:after="Search" />
<button @onclick="ClearText">Clear</button>
<p>@text</p>

<p>@searchResult</p>


@code {
    private int currentCount = 0;
    string text = "";
    string searchResult = "";

    private void IncrementCount()
    {
        currentCount++;
    }

    private void OnInputChange(ChangeEventArgs e)
    {
        text = e.Value?.ToString() ?? "";

    }

    private void ClearText()
    {
        text = "";
    }

    async private Task Search()
    {
        searchResult = $"Searching for '{text}'...";
        await Task.Delay(2000); // Simulate a search delay
        searchResult = $"Search completed for '{text}'!";
    }
}
